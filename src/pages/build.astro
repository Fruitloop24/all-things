---
import Base from '../layouts/Base.astro'
import PageBanner from '../components/PageBanner.astro'
import PhotoGrid from '../components/PhotoGrid.astro'
import EstimateCta from '../components/EstimateCta.astro'
import SimplePlanner from '../components/planner/SimplePlanner'
import { CONFIG } from '../config'

const b = CONFIG.build
const { newBuilds, barndo, remodels } = b.sections
const review = CONFIG.testimonials.find((t) => t.name === b.review)
---

<Base title={b.title} description={b.description}>
  <PageBanner photo={b.banner.photo} position={b.banner.position} eyebrow={b.eyebrow} headline={b.headline} intro={b.intro} />

  <section class="py-10 md:py-14 bg-warm-50">
    <div class="max-w-2xl mx-auto px-4 sm:px-6">
      <SimplePlanner kind="build" client:visible />
    </div>
  </section>

  <section class="py-14 md:py-20 bg-white border-t border-warm-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-8">
        <h2 class="font-heading text-2xl md:text-3xl font-bold text-stone-900 mb-3">{newBuilds.title}</h2>
        <p class="text-stone-600 leading-relaxed">{newBuilds.desc}</p>
      </div>
      <PhotoGrid photos={newBuilds.photos} />
    </div>
  </section>

  <section class="py-14 md:py-16 bg-warm-50 border-t border-warm-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-center">
        <div>
          <h2 class="font-heading text-2xl md:text-3xl font-bold text-stone-900 mb-3">{barndo.title}</h2>
          <p class="text-stone-600 leading-relaxed mb-5">{barndo.desc}</p>
          <a href={CONFIG.cta.primary.href} class="inline-flex items-center justify-center gap-2 bg-warm-700 hover:bg-warm-800 text-white px-6 py-3 rounded-xl font-semibold no-underline shadow-md transition-colors">
            {CONFIG.cta.primary.text}
          </a>
        </div>
        <figure class="rounded-2xl overflow-hidden border border-warm-200 bg-warm-100 shadow-sm">
          <img src={barndo.photo.src} alt={barndo.photo.alt} width={barndo.photo.w} height={barndo.photo.h} class="w-full h-auto block" loading="lazy" decoding="async" />
          <figcaption class="px-4 py-2.5 text-sm text-stone-500 bg-white">{barndo.caption}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="py-14 md:py-20 bg-white border-t border-warm-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-8">
        <h2 class="font-heading text-2xl md:text-3xl font-bold text-stone-900 mb-3">{remodels.title}</h2>
        <p class="text-stone-600 leading-relaxed">{remodels.desc}</p>
      </div>
      <PhotoGrid photos={remodels.photos} />

    </div>
  </section>

  {
    review && (
      <section class="py-14 md:py-16 bg-warm-50 border-t border-warm-100">
        <div class="max-w-3xl mx-auto px-4 sm:px-6">
          <figure class="bg-white rounded-2xl border border-warm-100 shadow-sm p-6 md:p-10">
            <div class="flex gap-1 mb-4" aria-label={`${review.rating} out of 5 stars`}>
              {Array.from({ length: review.rating }).map(() => (
                <svg class="w-5 h-5 text-yellow-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>
            <blockquote class="text-stone-600 text-base sm:text-lg leading-relaxed italic mb-5">&ldquo;{review.text}&rdquo;</blockquote>
            <figcaption>
              <div class="font-semibold text-stone-800">{review.name}</div>
              <div class="text-sm text-stone-400">{review.source} &middot; {review.project}</div>
            </figcaption>
          </figure>
        </div>
      </section>
    )
  }

  <EstimateCta headline={b.cta.headline} text={b.cta.text} />
</Base>
