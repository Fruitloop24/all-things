---
import Base from '../layouts/Base.astro'
import PageBanner from '../components/PageBanner.astro'
import PhotoGrid from '../components/PhotoGrid.astro'
import EstimateCta from '../components/EstimateCta.astro'
import FAQ from '../components/FAQ.astro'
import SimplePlanner from '../components/planner/SimplePlanner'
import { CONFIG } from '../config'

const c = CONFIG.custom
---

<Base title={c.title} description={c.description}>
  <PageBanner photo={c.banner.photo} position={c.banner.position} eyebrow={c.eyebrow} headline={c.headline} intro={c.intro} />

  <section class="py-10 md:py-14 bg-warm-50">
    <div class="max-w-2xl mx-auto px-4 sm:px-6">
      <SimplePlanner kind="custom" client:visible />
    </div>
  </section>

  <section class="py-14 md:py-20 bg-white border-t border-warm-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-8">
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-stone-900 mb-3">{c.feature.title}</h2>
        <p class="text-stone-600 leading-relaxed">{c.feature.desc}</p>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4">
        {
          c.feature.photos.map((p) => (
            <figure class="rounded-xl overflow-hidden border border-warm-100 bg-warm-100 shadow-sm aspect-[9/16]">
              <img src={p.src} alt={p.alt} width={p.w} height={p.h} class="w-full h-full object-cover" loading="lazy" decoding="async" />
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-14 md:py-20 bg-warm-50 border-t border-warm-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-8">
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-stone-900 mb-3">{c.other.title}</h2>
        <p class="text-stone-600 leading-relaxed">{c.other.desc}</p>
      </div>
      <PhotoGrid photos={c.other.photos} />
    </div>
  </section>

  <FAQ faqs={CONFIG.custom.faqs} headline="Custom Work Questions" />

  <EstimateCta headline={c.cta.headline} text={c.cta.text} />
</Base>
