---
import Base from '../layouts/Base.astro'
import PhotoGrid from '../components/PhotoGrid.astro'
import EstimateCta from '../components/EstimateCta.astro'
import { CONFIG } from '../config'

const c = CONFIG.custom
---

<Base title={c.title} description={c.description}>
  <section class="bg-gradient-to-b from-warm-100 to-warm-50 border-b border-warm-200 py-12 md:py-16 text-center">
    <div class="max-w-3xl mx-auto px-4">
      <p class="text-warm-700 text-xs font-semibold tracking-widest uppercase mb-2">{c.eyebrow}</p>
      <h1 class="font-heading text-3xl md:text-5xl font-bold text-warm-900 mb-3">{c.headline}</h1>
      <p class="text-stone-600 text-base md:text-lg leading-relaxed max-w-xl mx-auto">{c.intro}</p>
    </div>
  </section>

  <section class="py-14 md:py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-8">
        <h2 class="font-heading text-2xl md:text-3xl font-bold text-stone-900 mb-3">{c.feature.title}</h2>
        <p class="text-stone-600 leading-relaxed">{c.feature.desc}</p>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4">
        {
          c.feature.photos.map((p, i) => (
            <figure class="rounded-xl overflow-hidden border border-warm-100 bg-warm-100 shadow-sm aspect-[9/16]">
              <img src={p.src} alt={p.alt} width={p.w} height={p.h} class="w-full h-full object-cover" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-14 md:py-20 bg-warm-50 border-t border-warm-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-8">
        <h2 class="font-heading text-2xl md:text-3xl font-bold text-stone-900 mb-3">{c.other.title}</h2>
        <p class="text-stone-600 leading-relaxed">{c.other.desc}</p>
      </div>
      <PhotoGrid photos={c.other.photos} />
    </div>
  </section>

  <EstimateCta headline={c.cta.headline} text={c.cta.text} />
</Base>
