---
import Base from '../layouts/Base.astro'
import BookingForm from '../components/BookingForm'
import Suppliers from '../components/Suppliers.astro'
import { CONFIG } from '../config'

const ronFirst = CONFIG.team.management[0].name.split(' ')[0]
const jaymeFirst = CONFIG.team.management[1].name.split(' ')[0]
const emailHref = CONFIG.cta.email.href
const emailAddr = emailHref.replace(/^mailto:/, '')
---

<Base title={CONFIG.book.title} description={CONFIG.book.description}>
  <section class="bg-gradient-to-b from-warm-100 to-warm-50 border-b border-warm-200 py-12 md:py-16 text-center">
    <div class="max-w-3xl mx-auto px-4">
      <p class="text-warm-700 text-xs font-semibold tracking-widest uppercase mb-2">{CONFIG.book.eyebrow}</p>
      <h1 class="font-heading text-3xl md:text-5xl font-bold text-warm-900 mb-3">
        {CONFIG.book.headline}
      </h1>
      <p class="text-stone-600 text-base md:text-lg leading-relaxed max-w-xl mx-auto mb-6">
        Rather not fill anything in? Call or text us. Or leave a name and a number below and {ronFirst} or {jaymeFirst} will reach out to settle a time.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href={CONFIG.phone.href} class="inline-flex items-center justify-center gap-2 bg-warm-700 hover:bg-warm-800 text-white px-6 py-3 rounded-xl font-semibold no-underline shadow-md transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
          </svg>
          Call {CONFIG.phone.display}
        </a>
        <a href={`sms:${CONFIG.phone.raw}`} class="inline-flex items-center justify-center gap-2 border-2 border-warm-300 text-warm-700 hover:bg-warm-100 px-6 py-3 rounded-xl font-semibold no-underline transition-colors">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM2.25 12.76c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.184-4.183a1.14 1.14 0 01.778-.332 48.294 48.294 0 005.83-.498c1.585-.233 2.708-1.626 2.708-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" />
          </svg>
          Text us
        </a>
        {emailAddr && (
          <a href={emailHref} class="inline-flex items-center justify-center gap-2 border-2 border-warm-300 text-warm-700 hover:bg-warm-100 px-6 py-3 rounded-xl font-semibold no-underline transition-colors">
            Email us
          </a>
        )}
      </div>
    </div>
  </section>

  <section class="py-10 md:py-14 bg-warm-50">
    <div class="max-w-2xl mx-auto px-4 sm:px-6">
      <BookingForm client:load />
    </div>
  </section>

  <Suppliers bg="bg-white" />

  <section class="py-12 bg-white border-t border-warm-100 text-center">
    <div class="max-w-xl mx-auto px-4">
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-stone-900 mb-2">Rather just talk?</h2>
      <p class="text-stone-500 mb-6 text-sm md:text-base">Call or text {ronFirst} anytime.</p>
      <a
        href={CONFIG.phone.href}
        class="inline-flex items-center gap-2 bg-warm-700 hover:bg-warm-800 text-white px-6 py-3 rounded-xl font-semibold no-underline shadow-md transition-colors"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
        </svg>
        Call {CONFIG.phone.display}
      </a>
    </div>
  </section>
</Base>
