---
import Base from '../layouts/Base.astro'
import PageBanner from '../components/PageBanner.astro'
import PhotoGrid from '../components/PhotoGrid.astro'
import EstimateCta from '../components/EstimateCta.astro'
import FAQ from '../components/FAQ.astro'
import CabinetPlanner from '../components/planner/CabinetPlanner'
import { CONFIG } from '../config'

const c = CONFIG.cabinets
---

<Base title={c.title} description={c.description}>
  <PageBanner photo={c.banner.photo} position={c.banner.position} eyebrow={c.eyebrow} headline={c.headline} intro={c.intro} />

  <section id="planner" class="py-10 md:py-14 bg-warm-50 scroll-mt-32">
    <div class="max-w-2xl mx-auto px-4 sm:px-6">
      <CabinetPlanner client:visible />
    </div>
  </section>

  <section class="py-14 md:py-20 bg-white border-t border-warm-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-14">
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-stone-900">{c.galleryHeadline}</h2>
      {
        c.groups.map((g) => (
          <div>
            <h3 class="font-heading text-xl md:text-2xl font-bold text-stone-900 mb-5">{g.title}</h3>
            <PhotoGrid photos={g.photos} cols={g.photos.length < 3 ? 'two' : 'three'} />
          </div>
        ))
      }
    </div>
  </section>

  <FAQ faqs={CONFIG.cabinets.faqs} headline="Cabinet Questions" />

  <EstimateCta />
</Base>
