---
import Base from '../layouts/Base.astro'
import PhotoGrid from '../components/PhotoGrid.astro'
import EstimateCta from '../components/EstimateCta.astro'
import CabinetPlanner from '../components/CabinetPlanner'
import { CONFIG, PHOTOS } from '../config'

const c = CONFIG.cabinets
const lead = PHOTOS.whiteKitchenTall
---

<Base title={c.title} description={c.description}>
  <section class="bg-gradient-to-b from-warm-100 to-warm-50 border-b border-warm-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16 grid grid-cols-1 md:grid-cols-5 gap-8 md:gap-12 items-center">
      <div class="md:col-span-3">
        <p class="text-warm-700 text-xs font-semibold tracking-widest uppercase mb-2">{c.eyebrow}</p>
        <h1 class="font-heading text-3xl md:text-5xl font-bold text-warm-900 mb-4">{c.headline}</h1>
        <p class="text-stone-600 text-base md:text-lg leading-relaxed mb-6">{c.intro}</p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="#planner" class="inline-flex items-center justify-center gap-2 bg-warm-700 hover:bg-warm-800 text-white px-6 py-3 rounded-xl font-semibold no-underline shadow-md transition-colors">
            Plan your cabinets
          </a>
          <a href={CONFIG.cta.primary.href} class="inline-flex items-center justify-center gap-2 border-2 border-warm-300 text-warm-700 hover:bg-warm-100 px-6 py-3 rounded-xl font-semibold no-underline transition-colors">
            {CONFIG.cta.primary.text}
          </a>
        </div>
      </div>
      <div class="md:col-span-2">
        <img
          src={lead.src}
          alt={lead.alt}
          width={lead.w}
          height={lead.h}
          class="w-full h-auto rounded-2xl shadow-lg border border-warm-200 max-h-[28rem] md:max-h-none object-cover"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section class="py-14 md:py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-14">
      {
        c.groups.map((g) => (
          <div>
            <h2 class="font-heading text-2xl md:text-3xl font-bold text-stone-900 mb-5">{g.title}</h2>
            <PhotoGrid photos={g.photos} cols={g.photos.length < 3 ? 'two' : 'three'} />
          </div>
        ))
      }
    </div>
  </section>

  <section id="planner" class="py-14 md:py-20 bg-warm-50 border-t border-warm-100 scroll-mt-32">
    <div class="max-w-2xl mx-auto px-4 sm:px-6">
      <CabinetPlanner client:visible />
    </div>
  </section>

  <EstimateCta />
</Base>
