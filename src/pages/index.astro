---
import Base from '../layouts/Base.astro'
import FAQ from '../components/FAQ.astro'
import Suppliers from '../components/Suppliers.astro'
import QRCode from 'qrcode'
import { CONFIG } from '../config'

const { hero, services, progress, testimonials } = CONFIG
const words = hero.rotatingWords

const qrSvg = await QRCode.toString('https://allthingsflooringntile.com/', {
  type: 'svg',
  color: { dark: '#1a2744', light: '#ffffff' },
  margin: 0,
  width: 200,
})

const star = 'M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z'
const calendarIcon = 'M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5'
const phoneIcon = 'M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z'
const arrowIcon = 'M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3'
---

<Base>
  <!-- ════════════ 1. HERO: rotating gallery ════════════ -->
  <section class="relative overflow-hidden bg-warm-900 text-white">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 md:py-16 lg:py-20 grid grid-cols-1 lg:grid-cols-2 gap-0 lg:gap-14 items-center">
      <!-- Mobile: wrapper is display:contents so the gallery can sit between the headline and the copy. -->
      <div class="contents lg:block">
        <div data-reveal class="order-1 justify-self-start inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/10 px-4 py-2 rounded-full text-sm text-warm-200 mb-6">
          <span class="w-2 h-2 bg-green-400 rounded-full"></span>
          {hero.badge}
        </div>
        <h1 data-reveal data-reveal-delay="100" class="order-2 font-heading text-4xl sm:text-5xl lg:text-6xl font-bold leading-[1.1] mb-6">
          {hero.headline}
          <span id="hero-word" data-words={JSON.stringify(words)} class="block text-warm-300 transition-opacity duration-300 motion-reduce:transition-none" aria-hidden="true">{words[0]}</span>
          <span class="sr-only">{words.join(', ')}</span>
        </h1>
        <p data-reveal data-reveal-delay="200" class="order-4 text-lg sm:text-xl text-warm-200/90 leading-relaxed mb-8 max-w-lg">
          {hero.subheadline}
        </p>
        <div data-reveal data-reveal-delay="300" class="order-5 flex flex-col sm:flex-row gap-4">
          <a
            href={CONFIG.cta.primary.href}
            class="inline-flex items-center justify-center gap-2.5 bg-white text-warm-800 hover:bg-warm-100 px-8 py-4 rounded-xl text-base font-semibold transition-all no-underline shadow-lg shadow-black/20 hover:shadow-xl hover:-translate-y-0.5"
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d={calendarIcon} />
            </svg>
            {CONFIG.cta.primary.text}
          </a>
          <a
            href={CONFIG.cta.secondary.href}
            class="inline-flex items-center justify-center gap-2.5 border-2 border-warm-400/60 text-white hover:bg-white/10 px-8 py-4 rounded-xl text-base font-semibold transition-all no-underline backdrop-blur-sm"
          >
            {CONFIG.cta.secondary.text}
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d={arrowIcon} />
            </svg>
          </a>
        </div>
        <div data-reveal data-reveal-delay="400" class="order-6 flex items-center gap-4 mt-8 pt-6 border-t border-white/10">
          <div class="flex gap-0.5">
            {Array.from({ length: 5 }).map(() => (
              <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path d={star} />
              </svg>
            ))}
          </div>
          <p class="text-warm-300 text-sm">
            <strong class="text-white">{CONFIG.reviewsSummary}</strong>
          </p>
        </div>
      </div>

      <div id="hero-gallery" class="relative order-3 lg:order-none mb-6 lg:mb-0" role="region" aria-roledescription="carousel" aria-label="Photos of our work">
        <div class="relative aspect-[4/3] sm:aspect-square lg:aspect-[4/5] rounded-2xl overflow-hidden bg-warm-800 shadow-2xl shadow-black/30 border border-white/10">
          {
            hero.panels.map((panel, idx) => (
              <div
                class:list={[
                  'hero-panel absolute inset-0 transition-opacity duration-700 motion-reduce:transition-none',
                  idx === 0 ? 'opacity-100' : 'opacity-0 pointer-events-none',
                ]}
                data-index={idx}
                role="group"
                aria-roledescription="slide"
                aria-label={`${idx + 1} of ${hero.panels.length}: ${panel.label}`}
                aria-hidden={idx === 0 ? 'false' : 'true'}
              >
                {panel.photos.length === 1 ? (
                  <img
                    src={panel.photos[0].src}
                    alt={panel.photos[0].alt}
                    width={panel.photos[0].w}
                    height={panel.photos[0].h}
                    class="w-full h-full object-cover object-[center_65%]"
                    loading={idx === 0 ? 'eager' : 'lazy'}
                    fetchpriority={idx === 0 ? 'high' : undefined}
                  />
                ) : (
                  <div class="grid grid-cols-2 grid-rows-2 gap-1 w-full h-full">
                    {panel.photos.map((p) => (
                      <img src={p.src} alt={p.alt} width={p.w} height={p.h} class="w-full h-full object-cover min-h-0" loading="lazy" decoding="async" />
                    ))}
                  </div>
                )}
                <div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-black/60 to-transparent pointer-events-none"></div>
                <p class="absolute left-4 bottom-4 font-heading text-xl md:text-2xl font-bold text-white drop-shadow">{panel.label}</p>
              </div>
            ))
          }
        </div>
        <div class="flex items-center justify-center gap-4 mt-3">
          <button
            type="button"
            id="hero-prev"
            class="w-10 h-10 rounded-full border border-white/20 hover:bg-white/10 flex items-center justify-center text-warm-200 hover:text-white transition-colors cursor-pointer"
            aria-label="Previous photos"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
            </svg>
          </button>
          <div class="flex gap-2">
            {
              hero.panels.map((panel, i) => (
                <button
                  type="button"
                  class:list={[
                    'hero-dot h-1.5 rounded-full transition-all cursor-pointer',
                    i === 0 ? 'w-8 bg-warm-300' : 'w-1.5 bg-white/30 hover:bg-white/50',
                  ]}
                  data-index={i}
                  aria-label={`Show ${panel.label}`}
                />
              ))
            }
          </div>
          <button
            type="button"
            id="hero-next"
            class="w-10 h-10 rounded-full border border-white/20 hover:bg-white/10 flex items-center justify-center text-warm-200 hover:text-white transition-colors cursor-pointer"
            aria-label="Next photos"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════ 2. WHAT WE DO ════════════ -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div data-reveal class="text-center mb-12">
        <p class="text-warm-500 text-sm font-semibold tracking-widest uppercase mb-3">{services.eyebrow}</p>
        <h2 class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold text-stone-900 mb-4">{services.headline}</h2>
        <p class="text-stone-500 text-lg max-w-2xl mx-auto">{services.subheadline}</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          services.items.map((item, i) => (
            <div data-reveal data-reveal-delay={String(i * 100)} class="bg-warm-50 rounded-2xl border border-warm-100 overflow-hidden flex flex-col hover:shadow-lg transition-shadow">
              <a href={item.href} class="block aspect-[4/3] overflow-hidden bg-warm-100">
                <img src={item.photo.src} alt={item.photo.alt} width={item.photo.w} height={item.photo.h} class="w-full h-full object-cover" loading="lazy" decoding="async" />
              </a>
              <div class="p-6 flex flex-col flex-1">
                <h3 class="font-heading text-xl font-bold text-stone-900 mb-2">{item.title}</h3>
                <p class="text-stone-600 text-sm leading-relaxed mb-4">{item.desc}</p>
                {item.extra && (
                  <a href={item.extra.href} class="group block bg-white border border-warm-200 rounded-xl p-4 mb-4 no-underline hover:border-warm-400 transition-colors">
                    <span class="block text-sm font-semibold text-stone-800 mb-1">{item.extra.title}</span>
                    <span class="block text-xs text-stone-500 leading-relaxed mb-2">{item.extra.desc}</span>
                    <span class="inline-flex items-center gap-1 text-xs font-semibold text-warm-700">
                      {item.extra.linkText}
                      <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d={arrowIcon} />
                      </svg>
                    </span>
                  </a>
                )}
                <a href={item.href} class="group mt-auto inline-flex items-center gap-1.5 text-warm-700 hover:text-warm-800 text-sm font-semibold no-underline">
                  {item.linkText}
                  <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d={arrowIcon} />
                  </svg>
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ════════════ 3. HALFWAY, THEN FINISHED ════════════ -->
  <section class="py-16 md:py-24 bg-warm-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div data-reveal class="text-center mb-12">
        <p class="text-warm-500 text-sm font-semibold tracking-widest uppercase mb-3">{progress.eyebrow}</p>
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-stone-900 mb-3">{progress.headline}</h2>
        <p class="text-stone-500 max-w-xl mx-auto">{progress.subheadline}</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-start">
        {
          progress.pairs.map((pair, i) => (
            <div data-reveal data-reveal-delay={String(i * 100)} class="bg-white rounded-2xl border border-warm-100 shadow-sm p-3">
              <div class="grid grid-cols-2 gap-2">
                {[
                  { label: 'Halfway', p: pair.halfway },
                  { label: 'Finished', p: pair.finished },
                ].map(({ label, p }) => (
                  <figure class="relative rounded-lg overflow-hidden bg-warm-100" style={`aspect-ratio: ${pair.aspect};`}>
                    <img src={p.src} alt={p.alt} width={p.w} height={p.h} class="w-full h-full object-cover" loading="lazy" decoding="async" />
                    <figcaption
                      class:list={[
                        'absolute top-2 left-2 text-[11px] font-bold tracking-wider uppercase px-2 py-0.5 rounded',
                        label === 'Finished' ? 'bg-warm-700 text-white' : 'bg-white/90 text-stone-700',
                      ]}
                    >
                      {label}
                    </figcaption>
                  </figure>
                ))}
              </div>
              <h3 class="font-heading text-lg font-bold text-stone-900 px-2 pt-3 pb-1">{pair.title}</h3>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ════════════ 4. REVIEWS ════════════ -->
  <section class="py-16 md:py-24 bg-white texture-overlay">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div data-reveal class="text-center mb-12">
        <p class="text-warm-500 text-sm font-semibold tracking-widest uppercase mb-3">Reviews</p>
        <h2 class="font-heading text-3xl md:text-4xl font-bold text-stone-900 mb-2">What Our Customers Say</h2>
        <p class="text-stone-500">{CONFIG.reviewsSummary}</p>
      </div>

      <div data-reveal class="max-w-3xl mx-auto" id="testimonial-carousel">
        <div class="bg-warm-50 rounded-2xl shadow-sm border border-warm-100 p-6 sm:p-8 md:p-12 relative">
          <svg class="absolute top-6 left-8 w-10 h-10 text-warm-200/60" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4.583 17.321C3.553 16.227 3 15 3 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311 1.804.167 3.226 1.648 3.226 3.489a3.5 3.5 0 01-3.5 3.5c-1.073 0-2.099-.49-2.748-1.179zm10 0C13.553 16.227 13 15 13 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311 1.804.167 3.226 1.648 3.226 3.489a3.5 3.5 0 01-3.5 3.5c-1.073 0-2.099-.49-2.748-1.179z" />
          </svg>

          <!-- All slides share one grid cell, so the card is as tall as the longest review (no jump on rotate). -->
          <div class="grid">
            {
              testimonials.map((t, i) => (
                <div
                  class:list={['testimonial-slide [grid-area:1/1] relative', i === 0 ? 'visible' : 'invisible']}
                  data-index={i}
                  aria-hidden={i === 0 ? 'false' : 'true'}
                >
                  <div class="flex gap-1 mb-4" aria-label={`${t.rating} out of 5 stars`}>
                    {Array.from({ length: t.rating }).map(() => (
                      <svg class="w-5 h-5 text-yellow-500" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                        <path d={star} />
                      </svg>
                    ))}
                  </div>
                  <p class="text-stone-600 text-base sm:text-lg leading-relaxed mb-6 italic">&ldquo;{t.text}&rdquo;</p>
                  <div class="font-semibold text-stone-800">{t.name}</div>
                  <div class="text-sm text-stone-400">
                    {t.source}{t.project !== t.source && <> &middot; {t.project}</>}
                  </div>
                </div>
              ))
            }
          </div>

          <div class="flex items-center justify-between gap-4 mt-6">
            <div class="flex gap-2">
              {
                testimonials.map((_, i) => (
                  <button
                    type="button"
                    class:list={[
                      'testimonial-dot h-1.5 rounded-full transition-all cursor-pointer',
                      i === 0 ? 'w-8 bg-warm-500' : 'w-1.5 bg-warm-200 hover:bg-warm-300',
                    ]}
                    data-index={i}
                    aria-label={`Go to review ${i + 1}`}
                  />
                ))
              }
            </div>
            <div class="flex gap-2">
              <button
                type="button"
                id="testimonial-prev"
                class="w-10 h-10 rounded-full border border-warm-200 hover:bg-warm-100 flex items-center justify-center text-stone-500 hover:text-warm-700 transition-colors cursor-pointer"
                aria-label="Previous review"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                </svg>
              </button>
              <button
                type="button"
                id="testimonial-next"
                class="w-10 h-10 rounded-full border border-warm-200 hover:bg-warm-100 flex items-center justify-center text-stone-500 hover:text-warm-700 transition-colors cursor-pointer"
                aria-label="Next review"
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════ 4b. SUPPLIER LOGOS BAR ════════════ -->
  <Suppliers />

  <!-- ════════════ 5. GET THE APP ════════════ -->
  <section class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div data-reveal class="bg-gradient-to-br from-warm-50 to-warm-100 rounded-2xl border border-warm-200 p-8 md:p-12">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
          <div>
            <p class="text-warm-500 text-sm font-semibold tracking-widest uppercase mb-2">Get the App</p>
            <h2 class="font-heading text-2xl md:text-3xl font-bold text-stone-900 mb-4">Take Us With You</h2>
            <p class="text-stone-600 leading-relaxed mb-6">
              Get our app: the room visualizer, the cost calculator, and an easy way to reach us, right on your phone. Scan the QR code or follow the steps below to install.
            </p>
            <div class="space-y-3">
              <div class="flex items-start gap-3">
                <span class="w-7 h-7 bg-warm-700 text-white rounded-full flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">1</span>
                <p class="text-stone-600 text-sm">
                  <strong class="text-stone-800">iPhone:</strong> Tap the share button (box with arrow) in Safari, then tap <strong>"Add to Home Screen."</strong>
                </p>
              </div>
              <div class="flex items-start gap-3">
                <span class="w-7 h-7 bg-warm-700 text-white rounded-full flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">2</span>
                <p class="text-stone-600 text-sm">
                  <strong class="text-stone-800">Android:</strong> Tap the menu (three dots) in Chrome, then tap <strong>"Add to Home Screen"</strong> or <strong>"Install App."</strong>
                </p>
              </div>
              <div class="flex items-start gap-3">
                <span class="w-7 h-7 bg-warm-700 text-white rounded-full flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">3</span>
                <p class="text-stone-600 text-sm">
                  <strong class="text-stone-800">That's it!</strong> It works like an app, right on your home screen, always up to date.
                </p>
              </div>
            </div>
          </div>
          <div class="flex flex-col items-center">
            <div class="bg-white rounded-2xl p-6 shadow-md border border-warm-100">
              <div set:html={qrSvg} style="width: 200px; height: 200px;" />
            </div>
            <p class="text-stone-400 text-xs mt-3 text-center">Scan with your phone camera to open the site</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════ 6. FAQ ════════════ -->
  <FAQ />

  <!-- ════════════ 7. CLOSING CTA ════════════ -->
  <section class="py-16 md:py-24 bg-gradient-to-br from-warm-800 via-warm-800 to-warm-900 text-white relative overflow-hidden">
    <div
      class="absolute inset-0 opacity-[0.04]"
      style="background-image: repeating-linear-gradient(90deg, transparent, transparent 58px, rgba(255,255,255,0.2) 58px, rgba(255,255,255,0.2) 60px);"
    ></div>
    <div data-reveal class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="font-heading text-3xl md:text-4xl lg:text-5xl font-bold leading-tight mb-6">
        {CONFIG.closing.headline}
      </h2>
      <p class="text-warm-200 text-lg leading-relaxed mb-10 max-w-xl mx-auto">
        {CONFIG.closing.text}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={CONFIG.cta.primary.href}
          class="inline-flex items-center justify-center gap-2.5 bg-white text-warm-800 hover:bg-warm-100 px-8 py-4 rounded-xl font-semibold transition-all no-underline shadow-lg"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d={calendarIcon} />
          </svg>
          {CONFIG.cta.primary.text}
        </a>
        <a
          href={CONFIG.cta.call.href}
          class="inline-flex items-center justify-center gap-2.5 border-2 border-warm-400/60 text-white hover:bg-white/10 px-8 py-4 rounded-xl font-semibold transition-all no-underline"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d={phoneIcon} />
          </svg>
          {CONFIG.cta.call.text}
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  [data-reveal] {
    opacity: 0;
    transform: translateY(2rem);
    transition: opacity 700ms ease-out, transform 700ms ease-out;
  }
  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  // Reveal-on-scroll
  const revealEls = document.querySelectorAll<HTMLElement>('[data-reveal]')
  const obs = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement
          const delay = Number(el.dataset.revealDelay ?? 0)
          setTimeout(() => el.classList.add('is-visible'), delay)
          obs.unobserve(el)
        }
      })
    },
    { threshold: 0.15 }
  )
  revealEls.forEach((el) => obs.observe(el))

  // Hero gallery: auto-advance 5s, pauses on hover/touch/focus, no auto-advance with reduced motion
  const gallery = document.getElementById('hero-gallery')
  if (gallery) {
    const panels = gallery.querySelectorAll<HTMLElement>('.hero-panel')
    const dots = gallery.querySelectorAll<HTMLElement>('.hero-dot')
    const word = document.getElementById('hero-word')
    const words: string[] = JSON.parse(word?.dataset.words ?? '[]')
    let idx = 0
    let wordIdx = 0
    let paused = false
    let resumeTimer: ReturnType<typeof setTimeout> | undefined

    const show = (i: number) => {
      idx = (i + panels.length) % panels.length
      panels.forEach((p, pi) => {
        const on = pi === idx
        p.classList.toggle('opacity-100', on)
        p.classList.toggle('opacity-0', !on)
        p.classList.toggle('pointer-events-none', !on)
        p.setAttribute('aria-hidden', on ? 'false' : 'true')
      })
      dots.forEach((d, di) => {
        const on = di === idx
        d.classList.toggle('w-8', on)
        d.classList.toggle('bg-warm-300', on)
        d.classList.toggle('w-1.5', !on)
        d.classList.toggle('bg-white/30', !on)
      })
    }
    const nextWord = () => {
      if (!word || words.length < 2) return
      wordIdx = (wordIdx + 1) % words.length
      word.style.opacity = '0'
      setTimeout(() => {
        word.textContent = words[wordIdx]
        word.style.opacity = '1'
      }, 300)
    }

    if (!reduceMotion) {
      setInterval(() => {
        if (!paused && !document.hidden) show(idx + 1)
      }, 5000)
      setInterval(() => {
        if (!document.hidden) nextWord()
      }, 2500)
    }

    const pause = () => {
      paused = true
      if (resumeTimer) clearTimeout(resumeTimer)
    }
    const resumeLater = (ms: number) => {
      if (resumeTimer) clearTimeout(resumeTimer)
      resumeTimer = setTimeout(() => (paused = false), ms)
    }
    gallery.addEventListener('mouseenter', pause)
    gallery.addEventListener('mouseleave', () => resumeLater(0))
    gallery.addEventListener('focusin', pause)
    gallery.addEventListener('focusout', () => resumeLater(0))
    gallery.addEventListener('touchstart', pause, { passive: true })
    gallery.addEventListener('touchend', () => resumeLater(8000), { passive: true })

    document.getElementById('hero-prev')?.addEventListener('click', () => show(idx - 1))
    document.getElementById('hero-next')?.addEventListener('click', () => show(idx + 1))
    dots.forEach((d) => d.addEventListener('click', () => show(Number(d.dataset.index))))
  }

  // Review carousel: auto-rotate 7s
  const tCarousel = document.getElementById('testimonial-carousel')
  if (tCarousel) {
    const slides = tCarousel.querySelectorAll<HTMLElement>('.testimonial-slide')
    const dots = tCarousel.querySelectorAll<HTMLElement>('.testimonial-dot')
    const prevBtn = document.getElementById('testimonial-prev')
    const nextBtn = document.getElementById('testimonial-next')
    let tIdx = 0
    const showT = (i: number) => {
      tIdx = (i + slides.length) % slides.length
      slides.forEach((s, si) => {
        s.classList.toggle('visible', si === tIdx)
        s.classList.toggle('invisible', si !== tIdx)
        s.setAttribute('aria-hidden', si === tIdx ? 'false' : 'true')
      })
      dots.forEach((d, di) => {
        d.classList.toggle('w-8', di === tIdx)
        d.classList.toggle('bg-warm-500', di === tIdx)
        d.classList.toggle('w-1.5', di !== tIdx)
        d.classList.toggle('bg-warm-200', di !== tIdx)
      })
    }
    let tTimer: ReturnType<typeof setInterval> | undefined
    const start = () => {
      if (reduceMotion) return
      if (tTimer) clearInterval(tTimer)
      tTimer = setInterval(() => showT(tIdx + 1), 7000)
    }
    start()
    prevBtn?.addEventListener('click', () => {
      showT(tIdx - 1)
      start()
    })
    nextBtn?.addEventListener('click', () => {
      showT(tIdx + 1)
      start()
    })
    dots.forEach((d) =>
      d.addEventListener('click', () => {
        showT(Number(d.dataset.index))
        start()
      })
    )
  }
</script>
